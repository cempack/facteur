# Proton Mail Bridge (from `info` in the Bridge CLI)
BRIDGE_HOST=proton-bridge
BRIDGE_IMAP_PORT=1143
BRIDGE_SMTP_PORT=1025
BRIDGE_USER=you@example.com
BRIDGE_PASSWORD=bridge-generated-password
# BRIDGE_TLS=starttls        # starttls | tls | none
# BRIDGE_TLS_VERIFY=false    # Bridge's certificate is self-signed

# Who you can send as; the first is the default
FACTEUR_FROM=Your Name <you@example.com>, Your Name <alias@example.org>

# HTTP mode
FACTEUR_PUBLIC_URL=https://facteur.example.com
FACTEUR_ADMIN_PASSWORD=long-random-password   # or Cloudflare Access below
# FACTEUR_ACCESS_TEAM=yourteam                 # yourteam.cloudflareaccess.com
# FACTEUR_ACCESS_AUD=access-application-aud-tag
# FACTEUR_API_TOKEN=at-least-24-random-chars   # static token with every scope
TZ=Europe/Paris
